{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "acme-api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --port 8001"],
      "port": 8001,
      "url": "http://localhost:8001"
    },
    {
      "name": "acme-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5190", "--strictPort"],
      "port": 5190
    }
  ]
}
