# ACME Clinical web app — copy to frontend/.env.local for local development.
# On Vercel, add the same keys under Project → Settings → Environment Variables.

# Supabase project URL and the public anon (or "publishable") key. Safe for the browser.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the ACME Clinical API (FastAPI), without a trailing slash.
VITE_API_URL=http://localhost:8000

# Show the demo account shortcuts on the sign-in page.
VITE_SHOW_DEMO_ACCOUNTS=true
