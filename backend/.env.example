# ACME Clinical API — copy to backend/.env for local development.
# On Vercel, add the same keys under Project → Settings → Environment Variables.

ENVIRONMENT=development

# Supabase project URL and SERVICE ROLE key (Project Settings → API).
# The service role key bypasses row level security: keep it on the server only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browser origins allowed to call the API (comma separated, no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for preview deployments, e.g. https://acme-clinical-web-.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Public URL of the web app (used in simulated invitation emails).
FRONTEND_URL=http://localhost:5173

# Password given to the demo accounts created by scripts/seed.py.
DEMO_PASSWORD=AcmeDemo!2026

# Minimum seconds between automatic simulation ticks triggered by open browsers.
AUTO_TICK_MIN_INTERVAL=4
